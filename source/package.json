{
  "name": "atc-sim",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "description": "Browser ATC simulator with a headless, deterministic simulation engine",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "node tools/build-standalone.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/engine/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "sim": "tsx tools/run.ts",
    "replay": "tsx tools/replay.ts",
    "build:bridge": "node tools/build-bridge.mjs",
    "bridge": "tsx src/ai/bridge.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
